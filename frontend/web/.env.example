NEXT_PUBLIC_ENTRIES_API_URL=https://localhost:7212
NEXT_PUBLIC_MEDIA_API_URL=https://localhost:7157
NEXT_PUBLIC_OWNER_EMAIL=<owner-email>

# Dev only — Node's fetch rejects self-signed certs by default
NODE_TLS_REJECT_UNAUTHORIZED=0

AUTH_SECRET=replace-with-shared-hs256-secret-min-32-bytes
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret